    {
      "name": "1. Segurança sem login",
      "item": [
        {
          "name": "Área clínica sem login vai para o login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/clinico/pacientes",
              "host": [
                "{{base}}"
              ],
              "path": [
                "clinico",
                "pacientes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 302 (redirecionamento)', () => pm.response.to.have.status(302));",
                  "pm.test('Redireciona para /login', () => pm.expect(pm.response.headers.get('Location') || '').to.include('/login'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
