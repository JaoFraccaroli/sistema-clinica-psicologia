              "raw": "{{base}}/financeiro/cobrancas/exportar",
              "host": [
                "{{base}}"
              ],
              "path": [
                "financeiro",
                "cobrancas",
                "exportar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const bytes = pm.response.stream;",
                  "pm.test('Começa com BOM UTF-8 (acentos abrem certo no Excel)', () => pm.expect([bytes[0], bytes[1], bytes[2]]).to.eql([0xEF, 0xBB, 0xBF]));",
                  "const texto = pm.response.text().replace(/^\\uFEFF/, '');",
                  "const linhas = texto.trim().split(/\\r?\\n/);",
                  "pm.test('Cabeçalho com as 7 colunas separadas por ponto e vírgula', () => pm.expect(linhas[0]).to.eql('Código do paciente;Pagador;CPF do pagador;Valor;Vencimento;Situação;Data do pagamento'));",
                  "pm.test('Tem pelo menos uma cobrança', () => pm.expect(linhas.length).to.be.above(1));",
                  "pm.test('Toda linha tem 7 colunas', () => linhas.forEach(l => pm.expect(l.split(';').length, l).to.eql(7)));",
                  "pm.test('Nenhuma célula começa com = + - @ (proteção contra injeção de fórmula)', () => linhas.slice(1).forEach(l => l.split(';').forEach(c => pm.expect(c.replace(/^\"/, '')).to.not.match(/^[=+\\-@]/))));",
                  "pm.test('Traz as cobranças dos pacientes fictícios', () => { pm.expect(texto).to.include('PAC-DEMO0001'); pm.expect(texto).to.include('PAC-DEMO0002'); });",
                  "pm.test('Content-Type text/csv', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
                  "pm.test('Vem como anexo .csv para download', () => { const d = pm.response.headers.get('Content-Disposition') || ''; pm.expect(d).to.include('attachment'); pm.expect(d).to.include('.csv'); });",
                  "pm.test('Responde em menos de 1500 ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ]
