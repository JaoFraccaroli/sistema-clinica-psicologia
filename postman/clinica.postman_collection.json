        {
          "name": "Tela de login abre com cabeçalhos de segurança",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Página mostra \"Entrar\"', () => pm.expect(pm.response.text()).to.include('Entrar'));",
                  "const m = pm.response.text().match(/name=\"_csrf\"[^>]*value=\"([^\"]+)\"|value=\"([^\"]+)\"[^>]*name=\"_csrf\"/);",
                  "pm.test('Página traz o token CSRF', () => pm.expect(m, 'token _csrf não encontrado').to.not.be.null);",
                  "if (m) pm.collectionVariables.set('csrf', m[1] || m[2]);",
                  "pm.test('Responde em menos de 1500 ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "pm.test('X-Content-Type-Options: nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('X-Frame-Options: DENY (proteção contra clickjacking)', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY'));",
                  "pm.test('Cache-Control: no-store', () => pm.expect(pm.response.headers.get('Cache-Control') || '').to.include('no-store'));"
                ]
              }
            }
          ]
        },
